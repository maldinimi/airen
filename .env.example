# OpenAI-compatible vLLM endpoint. Run vLLM on port 8001; FastAPI uses port 8000.
VLLM_BASE_URL="http://localhost:8001/v1"
VLLM_API_KEY="EMPTY"
VLLM_MODEL="Qwen/Qwen2.5-3B-Instruct-AWQ"
VLLM_TIMEOUT_SECONDS="300"

# Frontend URL of the deployed FastAPI service (leave unset for local development).
VITE_API_URL="http://localhost:8000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
